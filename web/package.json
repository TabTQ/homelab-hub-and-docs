{
  "name": "homelab-hub-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:internal": "vite --config vite.internal.config.ts",
    "dev:docs-internal": "vite --config vite.docs-internal.config.ts",
    "build": "npm run build:public && npm run build:internal && npm run build:docs-public && npm run build:docs-internal",
    "build:public": "vite build --config vite.public.config.ts && node scripts/check-public-bundle.mjs",
    "build:internal": "vite build --config vite.internal.config.ts",
    "build:docs-public": "vite build --config vite.docs-public.config.ts && node scripts/check-public-bundle.mjs docs-public",
    "build:docs-internal": "vite build --config vite.docs-internal.config.ts && node scripts/check-docs-internal-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.4",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block-lowlight": "3.32.0",
    "@tiptap/extension-details": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lowlight": "3.3.0",
    "mermaid": "12.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
