# Copy to deploy/.env (never commit it). Values with $ must have every $ doubled ($$) for docker compose.
HUB_DATA=/opt/homelab-hub/data
HUB_PORT=3010
# From: printf 'your password\n' | java -jar hub-internal.jar hash-password   (then double every $)
HUB_PASSWORD_HASH=
# Extra names the dashboard answers to, e.g. the Pi's LAN name and Tailscale MagicDNS name (IPs always work)
HUB_ALLOWED_HOSTS=
# true only when EVERY way you open the dashboard is https (for example only through `tailscale serve`); over plain http login would fail
HUB_SECURE_COOKIES=false
# Time zone for "today" on the Budget page (settlement dates, "This month" export). The container itself runs in UTC.
HUB_BUDGET_ZONE=Asia/Kolkata
PROXMOX_API_URL=https://192.168.1.10:8006/api2/json
PROXMOX_API_TOKEN=user@pam!tokenid=secret
# pinned (default, needs fingerprint) | system | insecure
PROXMOX_TLS_MODE=pinned
PROXMOX_TLS_FINGERPRINT=
# Terminal page (README, "Terminal setup"). Off by default; needs a login (never works with HUB_AUTH_MODE=none).
HUB_TERMINAL_ENABLED=false
HUB_TERMINAL_IDLE_SECONDS=900
HUB_TERMINAL_MAX_SECONDS=7200
HUB_TERMINAL_MAX_SESSIONS=2
# Docker page (README, "Docker setup"). Off by default; needs a login (never works with HUB_AUTH_MODE=none).
HUB_DOCKER_ENABLED=false
