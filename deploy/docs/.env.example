# Copy to deploy/docs/.env on the Docs LXC (never commit it). Values with $ must have every $ doubled ($$) for docker compose.
DOCS_DATA=/opt/homelab-docs/data
DOCS_PORT=3020
# bcrypt hash of the Docs password (it can be the same password as the hub). Make it with either:
#   docker run --rm -i homelab-docs-internal:local hash-password      (after the first build), or
#   printf 'your password\n' | java -jar hub-internal.jar hash-password  (on the Pi)
# then double every $.
DOCS_PASSWORD_HASH=
# all (default) | edit | none
DOCS_AUTH_MODE=all
# Extra names Docs answers to, e.g. docs.<tailnet>.ts.net (IP addresses and localhost always work)
DOCS_ALLOWED_HOSTS=
# true only when EVERY way you open Docs is https (for example only through `tailscale serve`)
DOCS_SECURE_COOKIES=false
# Target of the "← Hub" link, e.g. https://<pi>.<tailnet>.ts.net
DOCS_HUB_URL=
# Allowed endings for public page addresses, comma separated, e.g. domain.com (empty = any valid hostname)
DOCS_DOMAINS=
# The public portfolio's address (the hostname you add to the docs tunnel, pointing to http://hub-public:3011). Shown as "Open public site".
DOCS_PORTFOLIO_URL=
DOCS_MAX_ASSET_MB=20
DOCS_MAX_BUNDLE_MB=25
# The "docs" Cloudflare Tunnel's token (Zero Trust -> Networks -> Tunnels -> docs -> install command). Never commit it.
TUNNEL_TOKEN=
# --- Cloudflare route automation (optional) ---
# When true, publishing a page creates its tunnel hostname rule + DNS record, unpublishing removes them. Start with DOCS_CF_DRY_RUN=true.
DOCS_CF_AUTOMATION_ENABLED=false
DOCS_CF_DRY_RUN=false
# API token scoped ONLY to Account > Cloudflare Tunnel: Edit and Zone > DNS: Edit, restricted to this account and zone. Never commit it.
DOCS_CF_API_TOKEN=
DOCS_CF_ACCOUNT_ID=
DOCS_CF_ZONE_ID=
DOCS_CF_TUNNEL_ID=
# The zone, e.g. domain.com. Pages must be one label below it (page1.domain.com).
DOCS_CF_ZONE_NAME=
# Names that can never be claimed, comma separated, e.g. the portfolio's label and other apps' labels (www, mail, vpn... are built in).
DOCS_CF_RESERVED_LABELS=
DOCS_INTERNAL_JAVA_OPTS=-Xmx256m -XX:+UseSerialGC -Xss512k
DOCS_PUBLIC_JAVA_OPTS=-Xmx128m -XX:+UseSerialGC -Xss512k
HUB_PUBLIC_JAVA_OPTS=-Xmx160m -XX:+UseSerialGC -Xss512k
